{
  "id": "timeout-failure",
  "description": "A retrieval timeout does not establish that the declaration has been intentionally withdrawn.",
  "role": "consumer",
  "conformance": "required",
  "rfc_sections": [
    "9",
    "11"
  ],
  "origin": "https://example.invalid",
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "uri": "https://example.invalid/.well-known/josh"
      },
      "failure": {
        "kind": "timeout"
      }
    }
  ],
  "expected": {
    "declaration": "temporary-failure",
    "participation": "indeterminate",
    "identity": "not-applicable"
  }
}
