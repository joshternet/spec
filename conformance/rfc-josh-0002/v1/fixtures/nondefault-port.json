{
  "id": "nondefault-port",
  "description": "A declaration for an origin using a non-default port is retrieved from that same port.",
  "role": "consumer",
  "conformance": "required",
  "rfc_sections": [
    "3.1",
    "4",
    "9",
    "14"
  ],
  "origin": "https://example.invalid:8443",
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "uri": "https://example.invalid:8443/.well-known/josh"
      },
      "response": {
        "status": 200,
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": "{\"version\":1,\"josh\":true}"
      }
    }
  ],
  "expected": {
    "declaration": "valid-v1",
    "participation": "declared",
    "identity": "affirmed"
  }
}
